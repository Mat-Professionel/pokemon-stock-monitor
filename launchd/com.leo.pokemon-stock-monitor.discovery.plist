<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.leo.pokemon-stock-monitor.discovery</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/leo/Library/Application Support/PokemonStockMonitor/run_local_monitor.zsh</string>
    <string>--discovery-only</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/leo/Library/Logs/PokemonStockMonitor/discovery.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/leo/Library/Logs/PokemonStockMonitor/discovery-error.log</string>
</dict>
</plist>
