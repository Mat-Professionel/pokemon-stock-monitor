<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.leo.pokemon-stock-monitor.health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/leo/Library/Application Support/PokemonStockMonitor/run_local_monitor.zsh</string>
    <string>--health-report</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/leo/Library/Logs/PokemonStockMonitor/health.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/leo/Library/Logs/PokemonStockMonitor/health-error.log</string>
</dict>
</plist>
